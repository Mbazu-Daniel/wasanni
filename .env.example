NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

DATABASE_URL=postgres://wasanni:wasanni@localhost:5432/wasanni
REDIS_URL=redis://localhost:6379

SESSION_SECRET=dev-session-secret-dev-session-secret-0001
WEBHOOK_SECRET_ENCRYPTION_KEY=dev-webhook-secret-key-dev-webhook-0001

PUBLIC_WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=test
R2_SECRET_ACCESS_KEY=test
R2_BUCKET_NAME=wasanni-local
R2_PUBLIC_ID=
R2_CUSTOM_DOMAIN=
STORAGE_ENDPOINT=http://localhost:4566
STORAGE_FORCE_PATH_STYLE=true

STORAGE_UPLOAD_URL_TTL_SECONDS=900
STORAGE_DOWNLOAD_URL_TTL_SECONDS=3600
STORAGE_MAX_GAME_BUNDLE_BYTES=209715200

EMAIL_FROM_ADDRESS=no-reply@wasanni.com
EMAIL_FROM_NAME=Wasanni
ZEPTOMAIL_API_KEY=

REALTIME_PORT=3001
REALTIME_PUBLIC_URL=ws://localhost:3001
API_INTERNAL_URL=http://localhost:3000
WS_IDLE_TIMEOUT_SECONDS=120
WS_MAX_MESSAGE_BYTES=65536

DB_POOL_MAX=10
DB_POOL_MAX_WORKER=5
DB_POOL_MAX_REALTIME=5
FD_LIMIT_MINIMUM=65535

SCORE_PARTITIONING_ENABLED=false
SCORE_PARTITION_PREMAKE_HOURS=24
SCORE_ARCHIVE_ENABLED=false
SCORE_ARCHIVE_CRON=0 3 * * *
SCORE_ARCHIVE_RETENTION_HOURS=168
SCORE_ARCHIVE_MAX_PARTITIONS_PER_RUN=24
SCORE_ARCHIVE_DRY_RUN=true

SCORE_RATE_LIMIT_PER_MINUTE=120
SESSION_RATE_LIMIT_PER_MINUTE=600

GAME_BUNDLE_MAX_UNCOMPRESSED_BYTES=1073741824
GAME_BUNDLE_MAX_FILES=20000

USAGE_METERING_ENABLED=true
SCORE_VERIFICATION_ENABLED=true

AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
AGENT_OTEL_ENDPOINT=

# bun run agent:studio — the port Mastra's HTTP API listens on, which
# https://studio.mastra.io connects to. Bound to 127.0.0.1.
MASTRA_STUDIO_PORT=4111

# development and test only: lets every url the api dials out to resolve to a
# private address — a model provider base url such as http://127.0.0.1:11434/v1
# and a game's score-verification callback. parseEnv refuses to boot when this is
# true and NODE_ENV is production.
ALLOW_PRIVATE_OUTBOUND_URLS=false

# bun run mcp — the stdio model context protocol server an external agent
# (Claude Desktop, Cursor, any mcp client) talks to. It calls the platform api
# as the organization that owns the key, so it needs a platform key and nothing
# else: the organization comes from the key.
WASANNI_BASE_URL=http://localhost:3000
WASANNI_API_KEY=
