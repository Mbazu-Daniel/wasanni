{
  "name": "wasanni",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "bun test",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:studio": "bun run --cwd packages/db studio",
    "agent:traces": "bun --env-file=.env scripts/agent-traces.ts",
    "agent:studio": "bun --env-file=.env apps/api/src/mastra-server.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "ci": "bun run typecheck && bun test",
    "mcp": "bun --env-file=.env apps/mcp/src/index.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/bun": "1.4.3",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "fflate": "0.8.3",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
