[Unit]
Description=Wasanni API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wasanni
WorkingDirectory=/opt/wasanni
EnvironmentFile=/opt/wasanni/.env
ExecStart=/usr/local/bin/bun run /opt/wasanni/apps/api/src/index.ts
Restart=always
RestartSec=3

LimitNOFILE=1048576:1048576
LimitNPROC=65536:65536
TasksMax=infinity

[Install]
WantedBy=multi-user.target
